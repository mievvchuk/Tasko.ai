// use prisma-8
// Prisma Schema for AIFreelanceSystem
// Models for managing freelance projects with AI agent integration

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  emailVerifiedAt TimestamptzJsDate? @default(now())
  passwordHash String
  role      String   // CLIENT, FREELANCER, ADMIN
  status    String   // ACTIVE, BLOCKED
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  // Лише посилання на фото профілю (напр. /avatars/<uuid>.jpg); сам файл — у storage/avatars
  avatarUrl String?
  createdAt TimestamptzJsDate @default(now())
  updatedAt TimestamptzJsDate

  // Relations
  ownedProjects    Project[]   @relation("ProjectClient")
  projectMembers   ProjectMember[]
  assignedTasks    Task[]      @relation("TaskAssignee")
  sentMessages     Message[]   @relation("MessageSender")
  submittedWork    WorkSubmission[] @relation("Submitter")
  reviewsGiven     WorkSubmission[] @relation("WorkSubmissionReviewer")
  projectApplications ProjectApplication[] @relation("ApplicationFreelancer")
  freelancerReviews   FreelancerReview[] @relation("ReviewedFreelancer")
  clientReviews       FreelancerReview[] @relation("ReviewClient")
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  freelancerProfile    FreelancerProfile?
  freelancerSkills     FreelancerSkill[]
  portfolioItems       PortfolioItem[]
  favoriteProjects     FavoriteProject[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  complaintsCreated    Complaint[] @relation("ComplaintReporter")
  complaintsReceived   Complaint[] @relation("ComplaintTarget")
}

model AuthSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  userAgent   String?
  ipAddress   String?
  createdAt   TimestamptzJsDate @default(now())
  expiresAt   TimestamptzJsDate
  revokedAt   TimestamptzJsDate?
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tokenHash   String   @unique
  createdAt   TimestamptzJsDate @default(now())
  expiresAt   TimestamptzJsDate
  usedAt      TimestamptzJsDate?
}

model EmailVerificationToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  tokenHash String @unique
  createdAt TimestamptzJsDate @default(now())
  expiresAt TimestamptzJsDate
  usedAt TimestamptzJsDate?
}

model Project {
  id        String   @id @default(uuid())
  clientId  String
  title     String
  description String?
  status    String   // PLANNING, ACTIVE, PAUSED, COMPLETED, CANCELLED
  deadline  TimestamptzJsDate?
  budgetMin Int?
  budgetMax Int?
  categoryId String?
  createdAt TimestamptzJsDate @default(now())
  updatedAt TimestamptzJsDate

  // Relations
  client    User     @relation("ProjectClient", fields: [clientId], references: [id])
  members   ProjectMember[]
  tasks     Task[]
  orders    Order[]
  messages  Message[]
  applications ProjectApplication[]
  freelancerReviews FreelancerReview[]
  category ProjectCategory? @relation(fields: [categoryId], references: [id])
  skills ProjectSkill[]
  favorites FavoriteProject[]
  milestones ProjectMilestone[]
  boardColumns BoardColumn[]
  notifications Notification[]
  activityLogs ActivityLog[]
  complaints Complaint[]
}

model ProjectApplication {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  freelancerId String
  freelancer   User     @relation("ApplicationFreelancer", fields: [freelancerId], references: [id])
  message      String
  proposedBudget Int
  proposedDays Int
  status       String   // PENDING, ACCEPTED, REJECTED
  portfolioItemId String?
  portfolioItem PortfolioItem? @relation(fields: [portfolioItemId], references: [id])
  aiScore Int?
  aiReason String?
  aiRankedAt TimestamptzJsDate?
  createdAt    TimestamptzJsDate @default(now())
  updatedAt    TimestamptzJsDate

  @@unique([projectId, freelancerId])
}

model FreelancerReview {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  clientId     String
  client       User     @relation("ReviewClient", fields: [clientId], references: [id])
  freelancerId String
  freelancer   User     @relation("ReviewedFreelancer", fields: [freelancerId], references: [id])
  rating       Int
  comment      String?
  createdAt    TimestamptzJsDate @default(now())

  @@unique([projectId, freelancerId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      String   // OWNER, ADMIN, MEMBER
  joinedAt  TimestamptzJsDate @default(now())

  @@unique([projectId, userId])
}

model Task {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  assigneeId String?
  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  title     String
  description String?
  priority  String   // LOW, MEDIUM, HIGH
  status    String   // TODO, IN_PROGRESS, REVIEW, DONE
  deadline  TimestamptzJsDate?
  // Додаткова колонка канбану (етап «До виконання» або «У процесі»); null — звичайна колонка
  columnId  String?
  column    BoardColumn? @relation(fields: [columnId], references: [id])
  createdAt TimestamptzJsDate @default(now())
  updatedAt TimestamptzJsDate
  notifications Notification[]
}

// Власні колонки канбану проєкту, напр. «Беклог», «Тестування»
model BoardColumn {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id])
  title String
  status String @default("IN_PROGRESS") // TODO або IN_PROGRESS — до якого етапу належить колонка
  position Int
  createdAt TimestamptzJsDate @default(now())
  tasks Task[]

  @@unique([projectId, position])
}

model FreelancerProfile {
  userId String @id
  user User @relation(fields: [userId], references: [id])
  bio String?
  hourlyRate Int?
  availability String // AVAILABLE, BUSY, UNAVAILABLE
  updatedAt TimestamptzJsDate
}

model Skill {
  id String @id @default(uuid())
  name String @unique
  freelancerSkills FreelancerSkill[]
  projectSkills ProjectSkill[]
}

model FreelancerSkill {
  userId String
  user User @relation(fields: [userId], references: [id])
  skillId String
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
}

model PortfolioItem {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  title String
  description String?
  url String
  createdAt TimestamptzJsDate @default(now())
  updatedAt TimestamptzJsDate
  applications ProjectApplication[]
}

model ProjectCategory {
  id String @id @default(uuid())
  name String @unique
  projects Project[]
}

model ProjectSkill {
  projectId String
  project Project @relation(fields: [projectId], references: [id])
  skillId String
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([projectId, skillId])
}

model FavoriteProject {
  userId String
  user User @relation(fields: [userId], references: [id])
  projectId String
  project Project @relation(fields: [projectId], references: [id])
  createdAt TimestamptzJsDate @default(now())

  @@id([userId, projectId])
}

model ProjectMilestone {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id])
  title String
  description String?
  position Int
  deadline TimestamptzJsDate?
  amount Int
  status String // PLANNED, IN_PROGRESS, REVIEW, COMPLETED
  paymentStatus String // UNPAID, RESERVED, PAID
  createdAt TimestamptzJsDate @default(now())
  updatedAt TimestamptzJsDate

  @@unique([projectId, position])
}

model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  type String
  message String
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  taskId String?
  task Task? @relation(fields: [taskId], references: [id])
  readAt TimestamptzJsDate?
  createdAt TimestamptzJsDate @default(now())
}

model ActivityLog {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id])
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  type String
  message String
  createdAt TimestamptzJsDate @default(now())
}

model Complaint {
  id String @id @default(uuid())
  reporterId String
  reporter User @relation("ComplaintReporter", fields: [reporterId], references: [id])
  targetUserId String?
  targetUser User? @relation("ComplaintTarget", fields: [targetUserId], references: [id])
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  reason String
  description String
  status String // OPEN, RESOLVED, REJECTED
  adminNote String?
  createdAt TimestamptzJsDate @default(now())
  updatedAt TimestamptzJsDate
}

model Message {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  content   String
  createdAt TimestamptzJsDate @default(now())
}

model Order {
  id        String   @id @default(uuid())
  clientId  String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  status    String   // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt TimestamptzJsDate @default(now())
  updatedAt TimestamptzJsDate
}

model FileAttachment {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  uploadedBy String
  uploader  User     @relation(fields: [uploadedBy], references: [id])
  fileName  String
  storagePath String
  mimeType  String
  size      Int
  uploadedAt TimestamptzJsDate @default(now())
  submissionId String?
  submission WorkSubmission? @relation(fields: [submissionId], references: [id])
}

model WorkSubmission {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  submittedBy String
  submitter User     @relation("Submitter", fields: [submittedBy], references: [id])
  description String
  status    String   // SUBMITTED, REVIEWING, APPROVED, REJECTED, NEEDS_REVISION
  submittedAt TimestamptzJsDate @default(now())
  reviewedAt  TimestamptzJsDate?
  reviewerId  String?
  reviewer    User?    @relation("WorkSubmissionReviewer", fields: [reviewerId], references: [id])
  feedback    String?
}
