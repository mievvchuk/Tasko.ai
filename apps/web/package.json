{
  "name": "tasko-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:show": "playwright test --headed --reporter=list",
    "test:e2e:client": "playwright test --reporter=list -g \"client|клієнт\"",
    "test:e2e:freelancer": "playwright test --reporter=list -g \"freelancer|фрилансер\"",
    "test:e2e:admin": "playwright test --reporter=list -g \"admin|адмін\""
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.2",
    "i18next": "26.5.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.2",
    "vite": "8.3.4"
  }
}
