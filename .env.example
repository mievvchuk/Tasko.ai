# Заповніть локальний .env власними значеннями. Не додавайте до Git.
DATABASE_URL=
JWT_SECRET=
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Необов'язково: HTTPS OpenAI-сумісний API, модель із function tools.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Необов'язково: сервіс Resend для листів відновлення пароля.
EMAIL_API_KEY=
EMAIL_FROM=Tasko.ai <noreply@example.com>

# Gmail SMTP: увімкніть 2FA Google та створіть пароль застосунку.
# Заповніть SMTP_HOST=smtp.gmail.com, SMTP_USER, SMTP_PASSWORD,
# EMAIL_FROM=ваша_адреса@gmail.com та EMAIL_VERIFICATION_REQUIRED=true.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_VERIFICATION_REQUIRED=false

# Для npm run admin:create. Приберіть ADMIN_PASSWORD після створення.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

