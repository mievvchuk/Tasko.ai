# Для розробки запити /api перенаправляє Vite на цей бекенд.
API_PROXY_TARGET=http://localhost:3000
# Для розгортання можна вказати публічну адресу API.
# Секрети та AI-ключі не повинні потрапляти у VITE_*.
VITE_API_URL=/api
# Необов'язково: OAuth Client ID для кнопки «Увійти через Google» (не секрет).
VITE_GOOGLE_CLIENT_ID=
