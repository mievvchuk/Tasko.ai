# Заповніть локальний .env власними значеннями. Не додавайте до Git.
DATABASE_URL=
JWT_SECRET=
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Необов'язково: HTTPS OpenAI-сумісний API, модель із function tools.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Необов'язково: «Увійти через Google». OAuth Client ID (тип Web application) з Google Cloud Console;
# той самий ID вкажіть у VITE_GOOGLE_CLIENT_ID для вебу. Client secret не потрібен.
GOOGLE_CLIENT_ID=

# Для npm run admin:create. Приберіть ADMIN_PASSWORD після створення.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

