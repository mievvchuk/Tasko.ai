flowchart TD
  A([Початок]) --> B[Клієнт публікує проєкт]
  B --> C[Фрилансери подають заявки]
  C --> D[Клієнт порівнює кандидатів]
  D --> E[Вибір виконавця]
  E --> F[Створення і призначення завдань]
  F --> G[Фрилансер виконує роботу]
  G --> H[Передає результат і файли]
  H --> I{Результат прийнято?}
  I -- Ні --> J[Коментар на доопрацювання]
  J --> G
  I -- Так --> K[Завершення завдання і проєкту]
  K --> L[Оцінка фрилансера]
  L --> M([Кінець])
